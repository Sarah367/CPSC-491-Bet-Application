# Copy this file to .env and adjust values as needed.
# 5000 conflicts with macOS's built-in AirPlay Receiver (confirmed on Velasco's machine too) — keep this off 5000.
PORT=5001

# Absolute or backend-relative path to the Firebase service account JSON key.
# Download from Firebase Console > Project settings > Service accounts.
# Never commit the key file itself — .gitignore covers common key filenames
# and the backend/secrets/ directory.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json
